{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "ROUTER_HOME=\"${CODEX_HOME:-$HOME/.codex}/router\" python3 \"${CODEX_HOME:-$HOME/.codex}/hooks/router/codex_spawn_guard.py\""
          }
        ]
      }
    ]
  }
}
