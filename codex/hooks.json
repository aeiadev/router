{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "ROUTER_HOME=\"${CODEX_HOME:-$HOME/.codex}/router\" sh \"${CODEX_HOME:-$HOME/.codex}/hooks/router/pyrun.sh\" router warn codex_spawn_guard.py"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "ROUTER_HOME=\"${CODEX_HOME:-$HOME/.codex}/router\" sh \"${CODEX_HOME:-$HOME/.codex}/hooks/router/pyrun.sh\" router warn context_guard.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "ROUTER_HOME=\"${CODEX_HOME:-$HOME/.codex}/router\" sh \"${CODEX_HOME:-$HOME/.codex}/hooks/router/pyrun.sh\" router warn session_note.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "ROUTER_HOME=\"${CODEX_HOME:-$HOME/.codex}/router\" sh \"${CODEX_HOME:-$HOME/.codex}/hooks/router/pyrun.sh\" router warn prompt_hint.py"
          }
        ]
      }
    ]
  }
}
