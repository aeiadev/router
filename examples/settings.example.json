{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/router/pyrun.sh\" router warn spawn_guard.py"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash|Edit|Write|SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/router/pyrun.sh\" router warn context_guard.py"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/router/pyrun.sh\" router warn context_guard.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/router/pyrun.sh\" router warn context_guard.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/router/pyrun.sh\" router warn session_note.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/router/pyrun.sh\" router warn judge_reminder.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/router/pyrun.sh\" router warn prompt_hint.py"
          }
        ]
      }
    ]
  }
}
