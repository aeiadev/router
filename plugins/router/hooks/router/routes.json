{
  "version": 1,
  "tiers": {
    "builder-in-place": {
      "light": {
        "agent": "builder-in-place-light",
        "model": "sonnet",
        "effort": "medium"
      },
      "std": {
        "agent": "builder-in-place-std",
        "model": "sonnet",
        "effort": "medium"
      },
      "up": {
        "agent": "builder-in-place-up",
        "model": "opus",
        "effort": "xhigh"
      }
    },
    "builder": {
      "light": {
        "agent": "builder-light",
        "model": "sonnet",
        "effort": "medium"
      },
      "std": {
        "agent": "builder-std",
        "model": "sonnet",
        "effort": "medium"
      },
      "up": {
        "agent": "builder-up",
        "model": "opus",
        "effort": "xhigh"
      }
    },
    "judge": {
      "std": {
        "agent": "judge-std",
        "model": "opus",
        "effort": "high"
      },
      "up": {
        "agent": "judge-up",
        "model": "opus",
        "effort": "xhigh"
      },
      "light": {
        "agent": "judge-light",
        "model": "opus",
        "effort": "high"
      }
    },
    "sweeper": {
      "light": {
        "agent": "sweeper-light",
        "model": "haiku",
        "effort": "none"
      },
      "std": {
        "agent": "sweeper-std",
        "model": "sonnet",
        "effort": "medium"
      },
      "up": {
        "agent": "sweeper-up",
        "model": "opus",
        "effort": "high"
      }
    },
    "researcher": {
      "std": {
        "agent": "researcher-std",
        "model": "sonnet",
        "effort": "medium"
      },
      "up": {
        "agent": "researcher-up",
        "model": "opus",
        "effort": "high"
      }
    },
    "planner": {
      "std": {
        "agent": "planner-std",
        "model": "sonnet",
        "effort": "high"
      },
      "up": {
        "agent": "planner-up",
        "model": "opus",
        "effort": "xhigh"
      }
    },
    "worker": {
      "std": {
        "agent": "worker-std",
        "model": "sonnet",
        "effort": "high"
      },
      "up": {
        "agent": "worker-up",
        "model": "opus",
        "effort": "xhigh"
      }
    }
  },
  "tier_sources": {
    "builder-in-place": {
      "source": "agents/builder-in-place.md",
      "prefix": "builder-in-place-"
    },
    "builder": {
      "source": "agents/builder.md",
      "prefix": "builder-"
    },
    "judge": {
      "source": "agents/judge.md",
      "prefix": "judge-"
    },
    "sweeper": {
      "source": "agents/sweeper.md",
      "prefix": "sweeper-"
    },
    "researcher": {
      "source": "agents/researcher.md",
      "prefix": "researcher-"
    },
    "planner": {
      "source": "agents/planner.md",
      "prefix": "planner-"
    },
    "worker": {
      "source": "agents/worker.md",
      "prefix": "worker-"
    }
  },
  "active_after": "",
  "brief": {
    "full": {"fields": ["TASK", "FILES", "BAR", "RETURN"], "roles": ["builder", "builder-in-place", "test-writer", "docs-writer", "worker", "judge"]},
    "read": {"fields": ["TASK", "RETURN"], "optional": ["FILES", "BAR"], "roles": ["sweeper", "researcher", "planner"]}
  },
  "router": {
    "modes": {
      "inject": "enforce",
      "redirect": "enforce",
      "block_model": "enforce",
      "risk": "shadow",
      "ladder": "enforce",
      "brief": "enforce",
      "rerun": "enforce",
      "judge_reminder": "enforce",
      "inject_unlisted": "enforce"
    },
    "types": {
      "sweeper": {
        "class": "sweep",
        "allow": [
          "haiku",
          "sonnet"
        ],
        "up": [
          "opus"
        ],
        "tiered": true
      },
      "builder": {
        "class": "exec",
        "allow": [
          "sonnet"
        ],
        "up": [
          "opus"
        ],
        "tiered": true
      },
      "builder-in-place": {
        "class": "exec",
        "allow": [
          "sonnet"
        ],
        "up": [
          "opus"
        ],
        "tiered": true
      },
      "judge": {
        "class": "judge",
        "allow": [
          "opus"
        ],
        "tiered": true
      },
      "worker": {
        "class": "worker",
        "allow": [
          "sonnet",
          "haiku"
        ],
        "up": [
          "opus"
        ],
        "tiered": true
      },
      "researcher": {
        "class": "research",
        "allow": [
          "sonnet",
          "haiku"
        ],
        "up": [
          "opus"
        ],
        "tiered": true,
        "inject": "sonnet"
      },
      "planner": {
        "class": "research",
        "allow": [
          "sonnet",
          "haiku"
        ],
        "up": [
          "opus"
        ],
        "tiered": true,
        "inject": "sonnet"
      },
      "test-writer": {
        "class": "exec",
        "allow": [
          "sonnet"
        ],
        "up": [
          "opus"
        ],
        "tiered": false,
        "inject": "sonnet"
      },
      "docs-writer": {
        "class": "exec",
        "allow": [
          "sonnet"
        ],
        "up": [
          "opus"
        ],
        "tiered": false,
        "inject": "sonnet"
      }
    },
    "never": [],
    "ladder_ttl_hours": 12,
    "lane_labels": true,
    "top_tier_models": [
      "gpt-6-astra"
    ],
    "unlisted": {
      "default_model": "sonnet",
      "models": {},
      "mode_key": "inject_unlisted"
    },
    "up_codes": [
      "risk",
      "security",
      "novel",
      "cross-cutting",
      "ladder"
    ],
    "risk_globs": [
      "*/.claude/hooks/*",
      "*/.claude/settings*",
      "*/.ssh/*",
      "*secret*",
      "*credential*",
      "*.env",
      "*/.env.*",
      "*auth*",
      "*payment*",
      "*migration*",
      "*/.github/workflows/*",
      "*deploy*"
    ],
    "risk_words": [
      "security",
      "secret",
      "credential",
      "auth",
      "payment",
      "migration",
      "deploy",
      "production",
      "irreversible"
    ]
  },
  "context": {
    "modes": {
      "start_note": "enforce",
      "stop_cap_seats": "enforce",
      "stop_cap_research": "shadow",
      "chain_note": "enforce",
      "large_read": "shadow"
    },
    "caps": {
      "exec": 1500,
      "judge": 1500,
      "sweep": 3000,
      "research": 5000,
      "worker": 5000
    },
    "chain": {
      "first": 5,
      "repeat": 10,
      "same_turn_ms": 1500,
      "idle_reset_s": 180
    },
    "large_read_bytes": 24000,
    "hint_min_score": 2,
    "hint_every": 3,
    "read_allow_globs": [
      "*/.claude/plans/*"
    ],
    "files_threshold": 3,
    "command_threshold": 2,
    "prompt_roles": {
      "docs-writer": {"docs": 2, "readme": 2},
      "test-writer": {"test": 1},
      "planner": {"plan": 1, "design": 2, "approach": 2},
      "researcher": {"compare": 2, "evaluate": 2, "should we": 2, "why": 1},
      "sweeper": {"find": 1, "list": 1, "count": 2, "where": 1},
      "builder": {"fix": 1, "add": 1, "implement": 2, "change": 1, "refactor": 2}
    }
  },
  "codex_models": {
    "haiku": {
      "model": "gpt-6-luna",
      "effort": "low"
    },
    "sonnet": {
      "model": "gpt-6-sol",
      "effort": "medium"
    },
    "opus": {
      "model": "gpt-6-astra",
      "effort": "high"
    }
  },
  "aliases": {
    "seat-exec": "builder",
    "seat-exec-here": "builder-in-place",
    "seat-judge": "judge",
    "seat-sweep": "sweeper",
    "general-purpose": "worker",
    "Explore": "researcher",
    "Plan": "planner",
    "seat-exec-light": "builder-light",
    "seat-exec-std": "builder-std",
    "seat-exec-up": "builder-up",
    "seat-exec-here-light": "builder-in-place-light",
    "seat-exec-here-std": "builder-in-place-std",
    "seat-exec-here-up": "builder-in-place-up",
    "seat-judge-light": "judge-light",
    "seat-judge-std": "judge-std",
    "seat-judge-up": "judge-up",
    "seat-sweep-light": "sweeper-light",
    "seat-sweep-std": "sweeper-std",
    "seat-sweep-up": "sweeper-up",
    "explore-std": "researcher-std",
    "explore-up": "researcher-up",
    "plan-std": "planner-std",
    "plan-up": "planner-up",
    "worker-std": "worker-std",
    "worker-up": "worker-up"
  }
}
