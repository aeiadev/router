#!/usr/bin/env python3
"""Routing switches: router on|off|status; router auto [off|suggest|nudge|enforce].

Other commands come from hooks/router/cmd_<name>.py files beside common.py; each defines
HELP and main(argv). Built-in names cannot be replaced by a command file.
"""
import sys
sys.dont_write_bytecode = True

import argparse
import ast
import importlib.util
import os
import re
import json
import subprocess
from pathlib import Path

package = Path(__file__).resolve().parents[1] / "hooks" / "router"
candidates = [package]


def has_common(directory) -> bool:
    try:
        return (directory / "common.py").is_file()
    except OSError:
        return False


def is_dir(directory) -> bool:
    try:
        return directory.is_dir()
    except OSError:
        return False


try:
    if not has_common(package):
        package = Path(__file__).resolve().parents[2] / "hooks" / "router"
        candidates.append(package)
    if not has_common(package):
        home = Path(os.environ.get("CLAUDE_HOME") or Path.home() / ".claude").expanduser()
        package = Path(os.environ.get("ROUTER_HOME") or home / "router").expanduser()
        candidates.append(package)
    sys.path.insert(0, str(package))
    import common
except (OSError, ImportError, SyntaxError) as exc:
    shown = next((path for path in candidates if is_dir(path)), package)
    print(f"router: cannot load the router hooks from {shown}: {type(exc).__name__}", file=sys.stderr)
    sys.exit(1)

BUILTINS = ("on", "off", "status", "auto")
COMMAND_FILE = re.compile(r"cmd_([a-z][a-z0-9_]*)\.py")


def command_dir() -> Path:
    """Where cmd_<name>.py files live: beside the real common.py (an installed copy may be a link)."""
    return Path(common.__file__).resolve().parent


def discover() -> dict:
    """Command name -> file, for every cmd_<name>.py in command_dir(), sorted by name."""
    try:
        entries = sorted(command_dir().iterdir())
    except OSError:
        return {}
    found = {}
    for path in entries:
        match = COMMAND_FILE.fullmatch(path.name)
        if match and match.group(1) not in BUILTINS and path.is_file():
            found[match.group(1)] = path
    return found


def command_help(path) -> str:
    """A command file's HELP string, read without running the file."""
    try:
        for node in ast.parse(path.read_text(encoding="utf-8")).body:
            if (isinstance(node, ast.Assign) and isinstance(node.value, ast.Constant)
                    and isinstance(node.value.value, str)
                    and any(isinstance(target, ast.Name) and target.id == "HELP" for target in node.targets)):
                return " ".join(node.value.value.split())
    except (OSError, SyntaxError, ValueError):
        pass
    return ""


def budget_ceilings(budget) -> dict:
    """CEILINGS from budget.py, read as a literal without running the file."""
    for node in ast.parse(budget.read_text(encoding="utf-8")).body:
        if (isinstance(node, ast.Assign)
                and any(isinstance(target, ast.Name) and target.id == "CEILINGS" for target in node.targets)):
            value = ast.literal_eval(node.value)
            if (isinstance(value, dict)
                    and all(isinstance(key, str) and type(item) is int for key, item in value.items())):
                return value
            break
    raise ValueError("no CEILINGS in budget.py")


def budget_lines() -> None:
    """Print the always-on estimate for each home with Router installed; never fails."""
    here = Path(__file__).resolve()
    candidate = next((path for path in (here.parent / "budget.py", here.parents[1] / "scripts" / "budget.py")
                      if path.is_file()), None)
    if candidate is None:
        print("budget: unavailable (scripts/budget.py is missing)")
        return
    try:
        codex = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex").expanduser()
        targets = [(name, home, host) for name, home, host in
                   (("claude", common.claude_home(), "claude"), ("codex", codex, "codex"))
                   if (home / "router" / "install-manifest.json").is_file()]
        if not targets:
            targets = [("checkout", here.parents[1], "claude")]
        ceilings = budget_ceilings(candidate)
        lines = []
        for name, home, host in targets:
            timeout = float(os.environ.get("ROUTER_STATUS_BUDGET_TIMEOUT", "10"))
            completed = subprocess.run([sys.executable, str(candidate), "--home", str(home), "--host", host, "--json"],
                                       stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=timeout)
            if completed.returncode:
                raise ValueError("budget subprocess failed")
            result = json.loads(completed.stdout)
            if (not isinstance(result, dict) or not isinstance(result.get("trees"), list)
                    or len(result["trees"]) != 1 or not isinstance(result.get("flags"), list)
                    or not all(isinstance(flag, str) for flag in result["flags"])):
                raise ValueError("bad budget result")
            row = result["trees"][0]
            if (not isinstance(row, dict) or not isinstance(row.get("label"), str)
                    or type(row.get("tokens")) is not int or type(row.get("bytes")) is not int):
                raise ValueError("bad budget row")
            ceiling = ceilings.get(row["label"])
            over = " OVER" if ceiling is not None and row["tokens"] > ceiling else ""
            lines.append(f"budget {name}: ~{row['tokens']} tokens always-on ({row['bytes']} B names and "
                         f"descriptions, estimate; ceiling {ceiling if ceiling is not None else 'none'}){over}")
            for flag in result["flags"]:
                lines.append(f"budget {name}: {flag}")
        print("\n".join(lines))
    except (Exception, SystemExit):
        print("budget: unavailable (scripts/budget.py failed)")


def overlay_line(problem):
    module = common._overlay_module()
    path = module.overlay_path()
    if path is None:
        return "overlay: off (ROUTER_LOCAL=off)"
    if problem:
        detail = problem["message"].removeprefix(f"routes overlay {path} is invalid: ")
        return f"overlay: invalid {path}: {' '.join(detail.split())}"
    patch = module.read_patch(path)
    if patch is None:
        return f"overlay: none ({path})"
    def leaves(value, prefix=""):
        for key, item in value.items():
            name = f"{prefix}.{key}" if prefix else key
            if isinstance(item, dict) and item:
                yield from leaves(item, name)
            else:
                yield name
    keys = sorted(leaves(patch))
    names = ", ".join(keys[:8]) if keys else "none"
    if len(keys) > 8:
        names += f", +{len(keys) - 8} more"
    return f"overlay: ok {path} (keys changed: {names})"


def listing(commands) -> str:
    rows = [("on | off | status", "switch routing on or off; status shows the modes"),
            ("auto [mode]", "automatic routing: " + ", ".join(common.AUTO_MODES))]
    rows += [(name, command_help(path)) for name, path in commands.items()]
    return "commands:\n" + "\n".join(f"  {name:<18}  {text}".rstrip() for name, text in rows)


def run_command(name, path, argv) -> int:
    folder = str(path.parent)
    if folder not in sys.path:
        sys.path.insert(1, folder)
    spec = importlib.util.spec_from_file_location(f"router_cmd_{name}", path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module.main(list(argv)) or 0


def main(argv=None):
    argv = sys.argv[1:] if argv is None else list(argv)
    commands = discover()
    if argv and argv[0] in commands:
        return run_command(argv[0], commands[argv[0]], argv[1:])
    if argv and argv[0] not in BUILTINS and not argv[0].startswith("-"):
        print(f"router: unknown command {argv[0]!r}\n{listing(commands)}", file=sys.stderr)
        return 2
    parser = argparse.ArgumentParser(prog="router", description=__doc__, epilog=listing(commands),
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("command", choices=BUILTINS)
    parser.add_argument("mode", nargs="?", choices=common.AUTO_MODES)
    args = parser.parse_args(argv)
    if args.command == "auto":
        if args.mode is not None:
            skipped = common.refresh_defaults(args.mode)
            common.set_auto_mode(args.mode)
            if skipped:
                print(f"Defaults were not updated in {', '.join(map(str, skipped))}; "
                      "reinstall with install.sh --with-defaults (select the same --host).")
        print(common.auto_mode())
        return 0
    if args.mode is not None:
        parser.error("a mode is only accepted with router auto")
    switch = common.off_file()
    if args.command == "off":
        switch.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        switch.touch(mode=0o600, exist_ok=True)
    elif args.command == "on":
        switch.unlink(missing_ok=True)
    print("off" if common.killed() else "on")
    print(f"switch: {switch}")
    if os.environ.get("ROUTER_OFF") == "1":
        print("ROUTER_OFF=1 is set; unset it to enable routing.")
    if args.command == "status":
        print(f"auto: {common.auto_mode()}")
        routes, problem = common.load_routes_checked()
        for section in ("router", "context"):
            for rule, mode in sorted(routes[section]["modes"].items()):
                print(f"{section}.{rule}: {mode}")
        print(overlay_line(problem))
        budget_lines()
        return 1 if problem else 0
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError) as exc:
        print(f"router: {exc}", file=sys.stderr)
        sys.exit(1)
